# Public address of the live site (canonical links, sitemap, share cards). With or without https://
NEXT_PUBLIC_SITE_URL=https://www.raysofwisdomsociety.net

# Set to "true" on the live site once the client signs off. Until then robots.txt blocks crawlers and every page is noindex.
NEXT_PUBLIC_INDEXABLE=false

# Where visitors get their IAAF 2026 e-pass (the separate festival e-pass site). Leave empty to hide the e-pass button.
NEXT_PUBLIC_EPASS_URL=

# Contact form delivery (server only). The form shows a clear "not configured" message and the email address until these are set.
# Create a key at https://resend.com and verify a sending domain.
RESEND_API_KEY=
CONTACT_TO_EMAIL=raysofwisdom@gmail.com
CONTACT_FROM_EMAIL=
